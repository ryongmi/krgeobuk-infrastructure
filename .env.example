# ============================================================================
# krgeobuk-infrastructure 환경 변수 템플릿
# ============================================================================
# 이 파일을 docker-compose 디렉토리에 .env로 복사하여 사용하세요
#
# 사용 방법:
#   cd docker-compose
#   cp ../.env.example .env
#   # 그 후 .env 파일을 편집하여 비밀번호 등을 변경하세요
#
# 주의사항:
#   - .env 파일은 절대 Git에 커밋하지 마세요!
#   - 운영 환경에서는 강력한 비밀번호를 사용하세요
# ============================================================================

# ============================================================================
# 포트 설정
# ============================================================================
# 모든 포트는 127.0.0.1로만 바인딩되어 외부 접근이 차단됩니다.
# 로컬 개발 환경에서만 localhost를 통해 접근 가능합니다.

# MySQL 포트 (기본값: 3306)
MYSQL_PORT=3306

# Redis 포트 (기본값: 6379)
REDIS_PORT=6379

# Jenkins HTTP 포트 (기본값: 9090)
# 주의: 기본 8080 대신 9090 사용 (다른 앱과 충돌 방지)
JENKINS_HTTP_PORT=9090

# Jenkins Agent 포트 (기본값: 50001)
# 주의: 기본 50000 대신 50001 사용
JENKINS_AGENT_PORT=50001

# Verdaccio NPM 레지스트리 포트 (기본값: 4873)
VERDACCIO_PORT=4873

# ============================================================================
# MySQL 보안 설정
# ============================================================================

# MySQL root 비밀번호 (관리자 계정)
# 개발: 간단한 비밀번호 사용 가능
# 운영: 강력한 비밀번호 필수 (최소 16자, 대소문자/숫자/특수문자 조합)
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# MySQL 개발 환경 사용자 비밀번호 (필수!)
# dev_user 계정에 사용되며, 모든 개발 DB에 접근 권한을 가집니다.
# - auth_dev, authz_dev, portal_dev, mypick_dev
MYSQL_DEV_USER_PASSWORD=your_strong_dev_password_here

# MySQL 운영 환경 사용자 비밀번호 (미니PC 배포 시 활성화)
# geobuk 계정에 사용되며, 모든 운영 DB에 접근 권한을 가집니다.
# - auth_prod, authz_prod, portal_prod, mypick_prod
# 사용 시 아래 주석을 해제하세요
# MYSQL_PROD_USER_PASSWORD=your_strong_prod_password_here

# ============================================================================
# Redis 보안 설정
# ============================================================================

# Redis 비밀번호
# 개발: 간단한 비밀번호 사용 가능
# 운영: 강력한 비밀번호 필수
REDIS_PASSWORD=your_strong_redis_password_here

# ============================================================================
# Jenkins 설정
# ============================================================================

# Jenkins 관리자 비밀번호
# 최초 실행 시 이 비밀번호로 admin 계정이 생성됩니다
JENKINS_ADMIN_PASSWORD=your_strong_jenkins_password_here

# ============================================================================
# 환경 설정
# ============================================================================

# 환경 구분 (development 또는 production)
# - development: 개발 환경 (로그 상세, 디버그 모드)
# - production: 운영 환경 (로그 최소화, 성능 최적화)
ENVIRONMENT=development

# ============================================================================
# 백업 설정 (선택사항)
# ============================================================================
# backup/mysql-backup.sh, backup/redis-backup.sh에서 사용됩니다.
# 설정하지 않으면 스크립트의 기본값이 사용됩니다.

# 백업 파일 보관 기간 (일 단위, 기본값: 7일)
# 이 기간보다 오래된 백업 파일은 자동 삭제됩니다.
# RETENTION_DAYS=7

# 백업 파일 저장 경로 (기본값: /opt/krgeobuk/backups/mysql 또는 redis)
# 충분한 디스크 공간이 있는 경로를 지정하세요.
# BACKUP_DIR=/opt/krgeobuk/backups
