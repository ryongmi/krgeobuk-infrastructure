# krgeobuk-infrastructure 환경 변수 템플릿
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env

# ============================================================================
# 포트 설정 (포트 충돌 시 변경 가능)
# ============================================================================

# MySQL 외부 포트 (기본값: 3306)
MYSQL_PORT=3306

# Redis 외부 포트 (기본값: 6379)
REDIS_PORT=6379

# Jenkins HTTP 포트 (기본값: 9090)
# 주의: 기본 8080 대신 9090 사용 (다른 앱과 충돌 방지)
JENKINS_HTTP_PORT=9090

# Jenkins Agent 포트 (기본값: 50001)
# 주의: 기본 50000 대신 50001 사용
JENKINS_AGENT_PORT=50001

# Verdaccio 포트 (기본값: 4873)
VERDACCIO_PORT=4873

# ============================================================================
# 보안 설정 (비밀번호)
# ============================================================================

# MySQL root 비밀번호
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# MySQL 애플리케이션 사용자 'geobuk' 비밀번호 (절대 Git에 커밋하지 마세요!)
MYSQL_DEV_USER_PASSWORD=your_strong_user_password_here
# MYSQL_PROD_USER_PASSWORD=your_strong_user_password_here

# Redis 비밀번호
REDIS_PASSWORD=your_strong_redis_password_here

# ============================================================================
# 기타 설정
# ============================================================================

# miniPC IP 주소 (Kubernetes External Service용)
MINIPC_IP=192.168.1.100

# 백업 설정
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/opt/krgeobuk/backups

# 환경 구분
ENVIRONMENT=development  # development or production
